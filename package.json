{
  "name": "dsh-sentry-telemetry",
  "version": "1.0.0",
  "description": "Sentry error and trace telemetry for DeepSeek Harness Host and Web Client",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cosmokit": "1.8.6",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-agent-loop": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-api-gateway": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-settings": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.4",
    "@deepseek-ai/schemastery": "3.18.5",
    "@sentry/browser": "^9.12.0",
    "@sentry/core": "^9.12.0",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.3"
  }
}
